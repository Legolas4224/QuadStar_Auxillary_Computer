	def ae_plate_solving_mode(self):
		self.picam2.set_controls({"AeEnable": False})
		#This set controls is just for testing the mode
		self.set_brightness(1000, 1.0)
		for _ in range(5):
			self.capture()

		min_exposure, max_exposure = 1000, 1000000
		min_gain, max_gain = 1.0, 16.0

		frame = self.capture()
		metadata = self.get_metadata()
		exposure_us = metadata["ExposureTime"]
		gain = metadata["AnalogueGain"]

		peak_brightness = np.percentile(frame, 99)
		print(f"Exposure Time: {exposure_us}, Gain: {gain}, Peak Brightness: {peak_brightness}")

		while True:
			if int(peak_brightness) != 253:
				scale = 253 / peak_brightness
				if gain != max_gain:
					gain *= scale
					if gain > max_gain:
						gain = max_gain
				else:
					exposure_us *= scale
					if exposure_us > max_exposure:
						exposure_us = max_exposure
				print(f"Exposure Time: {exposure_us}, Gain: {gain}, Peak Brightness: {peak_brightness}")

			self.set_brightness(int(exposure_us), gain)
			for _ in range(5):
				self.capture()
			frame = self.capture()
			peak_brightness = np.percentile(frame, 99)
